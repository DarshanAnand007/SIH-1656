import json
import requests

# Firebase Realtime Database URL
FIREBASE_URL = "https://samundar-sathi-default-rtdb.firebaseio.com/"  # Replace with your Realtime Database URL

# Function to write data to Firebase Realtime Database
def write_data_to_realtime_db(data, path="beaches"):
    url = f"{FIREBASE_URL}{path}.json"  # Removed ?auth={FIREBASE_AUTH}
    response = requests.put(url, json=data)
    if response.status_code == 200:
        print("Data successfully written to Realtime Database.")
    else:
        print(f"Failed to write data: {response.status_code} - {response.text}")

# Function to retrieve data from Firebase Realtime Database
def retrieve_data_from_realtime_db(path="beaches"):
    url = f"{FIREBASE_URL}{path}.json"  # Removed ?auth={FIREBASE_AUTH}
    response = requests.get(url)
    if response.status_code == 200:
        data = response.json()
        
        print("\n--- Beach Weather and Safety Data ---")
        
        # Check if the retrieved data is structured as expected
        if isinstance(data, dict):
            for key, value in data.items():
                if isinstance(value, dict):  # Ensure value is a dictionary
                    print(f"\nBeach Name: {value.get('name')}")
                    print(f"Location: ({value.get('latitude')}, {value.get('longitude')})")
                    print("Safety Report:")
                    print(f"  Safety Message: {value.get('safety_report', {}).get('safety_message')}")
                    print(f"  Safety Score: {value.get('safety_report', {}).get('safety_score')}")
                    
                    # Print only the first safety reason if available
                    reasons = value.get('safety_report', {}).get('reasons', [])
                    if reasons:
                        print(f"  Reason: {reasons[0]}")
                    else:
                        print("  No safety reasons available.")
                    
                    print(f"Timestamp: {value.get('timestamp')}")
                    print("\n-----------------------------------")
                else:
                    print(f"Unexpected data format for key '{key}': {value}")
        else:
            print("Data retrieved is not a dictionary:", data)

    else:
        print(f"Failed to retrieve data: {response.status_code} - {response.text}")

